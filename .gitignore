# Secretos (los .env viven fuera del control de versiones)
.env
Back/La Serranita entradas/.env

# Acceso directo a puertos sólo para desarrollo local (ver docker-compose.override.yml.example)
docker-compose.override.yml

# Sitios extra del Caddy de cada host, no se versionan (ver Caddyfile e caddy-extra en docker-compose.yml)
caddy-extra/*.caddy

# IDEs
.idea/

# Artefactos de compilación que se colaron alguna vez desde la raíz
*.class
/com/

# Certificado y clave de ARCA: nunca al repo.
/afip/

# Backups de la base (docker compose: servicio backup): nunca al repo.
/backups/

# Config de rclone (copia de backups a Google Drive): tiene el token de la cuenta de Google.
/rclone/

# Datos del VPS para scripts/deploy.sh (usuario, IP, ruta).
/scripts/deploy.local
