# Copiar a ".env" en esta misma carpeta y completar antes de "docker compose up".
# Este archivo (.env.example) sí se versiona porque no tiene valores reales; ".env" no.

# --- Base de datos ---
POSTGRES_DB=serranita
POSTGRES_USER=serranita
POSTGRES_PASSWORD=

# --- Autenticación del módulo interno ---
# Generar con: openssl rand -base64 48
JWT_SECRET=
# Opcionales: duración de la sesión (ms). Por defecto 12 horas, y 14 días con "Mantener sesión iniciada".
# JWT_EXPIRATION_MS=43200000
# JWT_REMEMBER_EXPIRATION_MS=1209600000

# --- Primer usuario ADMIN (sólo hace falta la primera vez que se levanta contra una
# base vacía; después de crear los usuarios reales desde Configuración > Usuarios, se
# pueden borrar estas dos líneas). Ojo: si la base se vacía, se vuelve a crear este usuario
# con esta contraseña — no dejar una contraseña débil acá. ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
# Dominio público del backend, SIN ruta: el backend le agrega /api/pagos/webhook solo
# (ej. https://tu-dominio.com). Si se pone con la ruta, queda duplicada y no llega ningún aviso.
MP_NOTIFICATION_URL=
# Clave de firma del webhook (Panel de Mercado Pago > tu aplicación > Webhooks > Firma secreta).
# Sin esto el backend acepta notificaciones sin validar quién las mandó: configurarla es obligatorio en producción.
MP_WEBHOOK_SECRET=
# Opcional: nombre que ve el cliente en el resumen de la tarjeta (máx. 13 caracteres, límite de Mercado Pago).
# Si no lo reconoce, desconoce el cargo. Por defecto "LA SERRANITA".
# MP_STATEMENT_DESCRIPTOR=LA SERRANITA
# Opcional: horas que se guarda el lugar de una compra online sin pagar. Pasado ese plazo se
# cancela sola, y el link de pago de Mercado Pago vence al mismo tiempo. Por defecto 3.
# CHECKOUT_ABANDONADO_HORAS=3

# --- Mail (envío de comprobantes) ---
# Servidor SMTP. Por defecto Gmail (smtp.gmail.com:587). Para una casilla de Hostinger: smtp.hostinger.com y 587.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcional: casilla que recibe una copia oculta (BCC) de cada mail. Vacío = no se envía copia.
MAIL_COPIA=
# Opcionales: teléfono/mail de contacto que se muestran en los mails de comprobante (el
# remitente es una casilla no-reply). Por defecto los datos públicos del parque.
# CONTACTO_TELEFONO=+5493547642649
# CONTACTO_EMAIL=info@laserranita.com.ar

# --- Dominios ---
# A dónde redirige Mercado Pago al usuario después de pagar (el dominio del front).
FRONTEND_URL=https://tu-dominio.com
# Quién puede pegarle a la API desde el navegador (CORS). Separar por coma si son varios.
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# --- HTTPS (Caddy) ---
# El dominio real apuntando a este servidor (registro DNS tipo A). Con esto seteado,
# Caddy pide y renueva el certificado de Let's Encrypt solo — no hace falta nada más.
# Sin esto (o en blanco), Caddy sirve en HTTP plano por localhost.
DOMAIN=tu-dominio.com
# Opcional: Let's Encrypt lo usa sólo para avisar si un certificado está por vencer.
CADDY_EMAIL=
